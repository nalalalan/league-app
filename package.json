{
  "name": "league-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:copy && npm run test:backend && npm run test:ui",
    "test:copy": "node scripts/check-samira-copy.mjs",
    "test:backend": "node scripts/check-samira-backend.mjs && node scripts/check-samira-recovery.mjs && node scripts/check-samira-coach-ai.mjs",
    "test:ui": "node scripts/check-samira-ui.mjs",
    "start": "node server.js",
    "sync:recordings": "node tools/sync-recordings.mjs",
    "publish:recordings": "node tools/publish-recordings.mjs",
    "watch:league": "node tools/league-live-recorder.mjs",
    "install:league-automation": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-league-automation.ps1",
    "verify:league-automation": "node tools/verify-league-automation.mjs",
    "audit:timestamps": "node tools/audit-recording-timestamps.mjs",
    "audit:feedback": "node tools/audit-feedback-quality.mjs",
    "audit:ranks": "node tools/audit-ranks.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
